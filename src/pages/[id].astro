---
import Layout from "../layouts/Layout.astro";
import { getDetailPost } from "../lib/apis";
import type { Post } from "../lib/types";

const { id } = Astro.params;
let post: Post | null = null;
let error: string | null = null;

try {
  post = await getDetailPost(String(id));
} catch (e) {
  error = e instanceof Error ? e.message : "Failed to fetch posts";
}

const frontmatter = {
  title: post?.title,
  description: post?.body,
  image:
    "https://img.antaranews.com/cache/1200x800/2022/08/03/IMG-20220803-WA0017_4.jpg.webp",
  content: post?.body,
};
---

<Layout frontmatter={frontmatter}>
  <main class="post-detail">
    {
      error ? (
        <div class="error-message">
          {error}
          <a href="/" class="back-link">
            ← Back to Posts
          </a>
        </div>
      ) : (
        <article class="post-container">
          <div class="post-header">
            <a href="/" class="back-link">
              ← Back to Posts
            </a>
            <div class="post-meta">
              <span class="post-id">Post #{post?.id}</span>
              <span class="post-author">By User {post?.userId}</span>
            </div>
            <h1 class="post-title">{post?.title}</h1>
          </div>

          <div class="post-image">
            <div class="placeholder-image">
              <span>Post {post?.id}</span>
            </div>
          </div>

          <div class="post-content">
            <p>{post?.body}</p>
          </div>
        </article>
      )
    }
  </main>
</Layout>

<style>
  .post-detail {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .post-container {
    background: white;
    border-radius: 12px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    overflow: hidden;
  }

  .post-header {
    padding: 2rem;
    background: #f8f9fa;
    border-bottom: 1px solid #eee;
  }

  .back-link {
    display: inline-block;
    color: #3498db;
    text-decoration: none;
    margin-bottom: 1.5rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: #2980b9;
  }

  .post-meta {
    display: flex;
    gap: 1rem;
    color: #666;
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .post-title {
    font-size: 2rem;
    font-weight: 700;
    color: #2c3e50;
    line-height: 1.3;
    margin: 0;
  }

  .post-image {
    width: 100%;
    height: 300px;
    overflow: hidden;
  }

  .placeholder-image {
    width: 100%;
    height: 100%;
    background: linear-gradient(45deg, #f0f0f0, #e0e0e0);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #999;
    font-size: 1.2rem;
  }

  .post-content {
    padding: 2rem;
    line-height: 1.6;
    color: #444;
  }

  .post-content p {
    margin: 0;
    font-size: 1.1rem;
  }

  .post-footer {
    padding: 1.5rem 2rem;
    border-top: 1px solid #eee;
  }

  .share-buttons {
    display: flex;
    gap: 1rem;
  }

  .share-button,
  .like-button {
    padding: 0.5rem 1rem;
    border: none;
    border-radius: 6px;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .share-button {
    background: #3498db;
    color: white;
  }

  .share-button:hover {
    background: #2980b9;
  }

  .like-button {
    background: #f0f0f0;
    color: #444;
  }

  .like-button:hover {
    background: #e0e0e0;
  }

  .error-message {
    background: #fee2e2;
    color: #dc2626;
    padding: 2rem;
    border-radius: 12px;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
  }

  @media (max-width: 768px) {
    .post-detail {
      padding: 1rem;
    }

    .post-title {
      font-size: 1.5rem;
    }

    .post-image {
      height: 200px;
    }

    .post-content {
      padding: 1.5rem;
    }
  }
</style>
