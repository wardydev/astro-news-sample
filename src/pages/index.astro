---
import CardPost from "../components/CardPost.astro";
import Layout from "../layouts/Layout.astro";
import { getPosts } from "../lib/apis";
import type { Post } from "../lib/types";

let posts: Post[] = [];
let error: string | null = null;

try {
  posts = await getPosts();
} catch (e) {
  error = e instanceof Error ? e.message : "Failed to fetch posts";
}

const frontmatter = {
  title: "Ceritanya ini landing page",
  description: "Ceritanya ini adalah description dari landing pagenya",
  image:
    "https://img.antaranews.com/cache/1200x800/2022/08/03/IMG-20220803-WA0017_4.jpg.webp",
  content: "Content landing page",
};
---

<Layout frontmatter={frontmatter}>
  <main id="container">
    <div class="posts-container">
      {
        error ? (
          <div class="error-message">{error}</div>
        ) : (
          posts.map((post) => <CardPost post={post} />)
        )
      }
    </div>
  </main>
</Layout>

<style>
  .posts-container {
    max-width: 1200px;
    margin: 2rem auto;
    padding: 0 1rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem;
  }

  .error-message {
    background-color: #fee2e2;
    border: 1px solid #ef4444;
    color: #dc2626;
    padding: 1rem;
    border-radius: 0.5rem;
    margin: 2rem auto;
    max-width: 600px;
  }

  @media (max-width: 768px) {
    .posts-container {
      gap: 1rem;
    }
  }
</style>
