---
import type { Post } from "../lib/types";

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<div class="post-card">
  <div class="post-content">
    <h2 class="post-title">
      <a href={`/${post.id}`}>{post.title}</a>
    </h2>
    <p class="post-excerpt">{post.body.substring(0, 100)}...</p>
    <div class="post-footer">
      <span class="post-id">#{post.id}</span>
      <a href={`/${post.id}`} class="read-more">Read more →</a>
    </div>
  </div>
</div>

<style>
  .post-card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    transition: transform 0.2s ease-in-out;
    margin: 1rem;
    width: 300px;
    border: 1px solid #eee;
  }

  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 12px rgba(0, 0, 0, 0.1);
  }

  .post-image {
    width: 100%;
    height: 160px;
    overflow: hidden;
  }

  .placeholder-image {
    width: 100%;
    height: 100%;
    background: linear-gradient(45deg, #f0f0f0, #e0e0e0);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #999;
    font-size: 1.2rem;
  }

  .post-content {
    padding: 1.5rem;
  }

  .post-title {
    margin: 0 0 1rem 0;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .post-title a {
    color: #2c3e50;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .post-title a:hover {
    color: #3498db;
  }

  .post-excerpt {
    color: #666;
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }

  .post-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid #eee;
  }

  .post-id {
    color: #999;
    font-size: 0.9rem;
  }

  .read-more {
    color: #3498db;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .read-more:hover {
    color: #2980b9;
  }
</style>
